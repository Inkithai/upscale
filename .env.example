# Copy to .env and adjust. Never commit secrets.

# Uploads
MAX_UPLOAD_SIZE=83886080
MAX_ZIP_SIZE=209715200
MAX_IMAGES_PER_BATCH=80
MAX_EXTRACTED_SIZE=419430400
MAX_ZIP_RATIO=200

# Input image limits
MAX_IMAGE_PIXELS=12000000
MAX_IMAGE_SIDE=8000

# Output
MIN_OUTPUT_SIZE_MB=4.0
UPSCALE_FACTOR=4
JPEG_QUALITY=95
MAX_OUTPUT_PIXELS=64000000
MAX_OUTPUT_SIDE=16000

# Runtime
MAX_CONCURRENT_JOBS=1
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
PREVIEW_MAX_SIDE=720
TRANSPARENCY_BG=#FFFFFF
UPSCALE_BACKEND=auto
LOG_LEVEL=INFO

# Optional paths
# JOBS_DIR=/tmp/upscale-jobs
# MODEL_DIR=/app/backend/models
